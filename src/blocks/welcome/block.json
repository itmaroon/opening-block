{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "itmar/welcome",
	"title": "WelCome",
	"category": "design",
	"version": "0.1.0",
	"supports": {
		"multiple": false,
		"html": false
	},
	"attributes": {
		"bg_Color": {
			"type": "string",
			"default": "#d2def3"
		},
		"bg_Gradient": {
			"type": "string"
		},
		"logo_fillColor": {
			"type": "string",
			"default": "#000"
		},
		"welcome_text": {
			"type": "string",
			"default": "Welcome"
		},
		"welcome_font": {
			"type": "string",
			"default": "Roboto-Black.ttf"
		},
		"logo_size": {
			"type": "number",
			"default": 72
		},
		"logo_gap": {
			"type": "number",
			"default": 4
		},
		"logo_width": {
			"type": "number",
			"default": 0
		},
		"logo_height": {
			"type": "number",
			"default": 0
		},
		"outline_paths": {
			"type": "array",
			"default": []
		},
		"centerline_paths": {
			"type": "array",
			"default": []
		},
		"path_lengths": {
			"type": "array",
			"default": []
		},
		"centerline_order": {
			"type": "array",
			"default": []
		},
		"centerline_reversed": {
			"type": "array",
			"default": []
		},
		"animation_duration": {
			"type": "number",
			"default": 5.5
		},
		"skeleton_scale": {
			"type": "number",
			"default": 1.5
		},
		"mask_stroke_width": {
			"type": "number",
			"default": 8
		},
		"use_dynamic_paths": {
			"type": "boolean",
			"default": true
		},
		"trigger_anime": {
			"type": "boolean",
			"default": false
		},
		"is_anime": {
			"type": "boolean",
			"default": false
		},
		"is_front": {
			"type": "boolean",
			"default": true
		},
		"ending_type": {
			"type": "string",
			"default": "virtical_slide"
		},
		"is_check_enable": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "opening-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
